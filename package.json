{
  "name": "fzt-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "postinstall": "node -e \"const fs=require('fs'),path=require('path');const dist=path.join(path.dirname(require.resolve('@romaine-life/fzt-browser/package.json')),'dist');for(const name of ['fzt.wasm','fzt-terminal.js','fzt-terminal.css','fzt-web.js'])fs.copyFileSync(path.join(dist,name),path.join('src',name));\""
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  },
  "dependencies": {
    "@romaine-life/fzt-browser": "0.1.117"
  }
}
